<%- include('_header') %>
<h1>Хянах самбар</h1>
<% if (!fbReady && user.role === 'admin') { %>
  <div class="flash flash-info">Facebook пэйж холбогдоогүй байна. Мэдээгээ автоматаар Facebook-д нийтлэхийн тулд <a href="/admin/settings">Тохиргоо</a> хэсэгт пэйжийн ID болон access token оруулна уу.</div>
<% } %>
<div class="stats">
  <div class="stat"><b><%= stats.total %></b><span>Нийт мэдээ</span></div>
  <div class="stat"><b><%= stats.published || 0 %></b><span>Нийтлэгдсэн</span></div>
  <div class="stat"><b><%= stats.drafts || 0 %></b><span>Ноорог</span></div>
  <div class="stat"><b><%= stats.views %></b><span>Нийт үзэлт</span></div>
  <div class="stat"><b><%= stats.fb || 0 %></b><span>Facebook-д нийтэлсэн</span></div>
</div>
<div class="panel">
  <div class="panel-head"><h2>Сүүлд засварласан</h2><a href="/admin/articles/new" class="btn btn-primary">+ Мэдээ нэмэх</a></div>
  <%- include('_table', { articles: recent }) %>
</div>
<%- include('_footer') %>
