<div class="share">
  <a class="share-fb" target="_blank" rel="noopener" href="https://www.facebook.com/sharer/sharer.php?u=<%= encodeURIComponent(url) %>">Facebook-т хуваалцах</a>
  <% if (settings.fb_app_id) { %>
  <a class="share-ms" target="_blank" rel="noopener" href="https://www.facebook.com/dialog/send?link=<%= encodeURIComponent(url) %>&app_id=<%= settings.fb_app_id %>&redirect_uri=<%= encodeURIComponent(url) %>">Messenger</a>
  <% } %>
  <a class="share-x" target="_blank" rel="noopener" href="https://twitter.com/intent/tweet?url=<%= encodeURIComponent(url) %>">X</a>
  <button type="button" class="share-copy" data-url="<%= url %>" onclick="navigator.clipboard.writeText(this.dataset.url).then(() => { this.textContent = 'Хуулсан ✓' })">Холбоос хуулах</button>
</div>
